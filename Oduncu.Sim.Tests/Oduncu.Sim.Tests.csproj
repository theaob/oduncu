<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the same NUnit tests Unity's Test Runner runs, without Unity. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Oduncu.Sim.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Oduncu.Unity/Assets/Sim.Tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Oduncu.Sim/Oduncu.Sim.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
