<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless build of the simulation. The source of truth lives in the Unity project;
       this project just compiles the same files for servers, tools and CI. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Oduncu.Sim</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Oduncu.Unity/Assets/Sim/**/*.cs" />
  </ItemGroup>

</Project>
